# =============================================================================
# Renata — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values.

# --- Database (required) ------------------------------------------------------
# Local:  docker compose up -d
#         Then use the connection string below (or Neon in production).
DATABASE_URL=postgresql://renata:renata@127.0.0.1:5432/renata
# Same as DATABASE_URL for local. On Neon, use the "direct" string for migrations.
DATABASE_URL_UNPOOLED=postgresql://renata:renata@127.0.0.1:5432/renata
# Vercel Postgres integration sets STORAGE_POSTGRES_URL* instead; migrate.mjs and
# lib/db fall back to those when DATABASE_URL is empty.

# --- NextAuth (required) ------------------------------------------------------
AUTH_SECRET=                    # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Vercel Blob (file uploads) ---------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- AI Gateway (OIDC) ------------------------------------------------------
VERCEL_OIDC_TOKEN=

# --- Donations --------------------------------------------------------------
NEXT_PUBLIC_BTC_ADDRESS=
NEXT_PUBLIC_ETH_ADDRESS=

# --- Web Search (Tavily) ----------------------------------------------------
TAVILY_API_KEY=

# --- OpenAI (TTS for 3D avatar lip-sync from real audio waveform) ------------
# Used by POST /api/tts — optional; without it, avatar falls back to browser speech.
OPENAI_API_KEY=

# --- Meshy (admin-only 3D avatar from image) ----------------------------------
# https://www.meshy.ai/api — used for Image-to-3D (renata-avatar.png → GLB).
MESHY_API_KEY=

# --- Telegram Bot (integration) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
