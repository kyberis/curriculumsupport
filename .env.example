# =============================================================================
# CurriculumSupport — Environment Variables
# =============================================================================
# Copy to .env.local and fill in values.
# Most are auto-provisioned by Vercel Marketplace integrations.

# --- Clerk (auth) -----------------------------------------------------------
# Auto-provisioned by: vercel integration add clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Manual — add after installing Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Neon Postgres (database) -----------------------------------------------
# Auto-provisioned by: vercel integration add neon
DATABASE_URL=                 # pooled — used by the app at runtime
DATABASE_URL_UNPOOLED=        # direct — used by drizzle-kit migrate only

# --- Vercel Blob (file uploads) ---------------------------------------------
# Auto-provisioned by: vercel blob create cv-uploads
BLOB_READ_WRITE_TOKEN=

# --- AI Gateway (OIDC) ------------------------------------------------------
# Auto-provisioned by: vercel env pull
# Valid ~24h locally; auto-refreshed on Vercel deployments
VERCEL_OIDC_TOKEN=
